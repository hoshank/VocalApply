# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# Vite inlines every VITE_* value at build time. The key fallback in the app is
# gated on import.meta.env.DEV, so the build strips it and dist/ does not carry
# it -- measured, not assumed. Still use a throwaway, revocable key: this file is
# plaintext on disk, and any NEW VITE_* you add without a DEV guard WILL be
# inlined into dist/ verbatim.

# Prefills the key field in the voice dock. Still overridable in the UI.
# Optional: without a key the page still runs the scripted walkthrough, which
# drives the same nine tools with no socket and no microphone. A key only buys
# the live session, where you can talk to it and it can answer.
VITE_GEMINI_API_KEY=

# Optional. Overrides LIVE_MODEL / LIVE_VOICE in src/voice/liveClient.ts.
# Must be a Live-capable model id; a normal Flash id will not open the socket.
# Defaults when blank: gemini-3.1-flash-live-preview / Aoede
VITE_GEMINI_LIVE_MODEL=
VITE_GEMINI_LIVE_VOICE=

# Optional. How hard the model may think per turn: minimal | low | medium | high.
# Voice pays for thinking in silence before the first audio chunk, not just tokens.
# Default when blank: high
VITE_GEMINI_LIVE_THINKING_LEVEL=

# Prefills the OpenAI key field in the voice dock (the second live provider,
# alongside Gemini). Mints its own ephemeral token directly from the browser --
# see src/voice/openaiRealtimeClient.ts for why that is measured as safe to do
# here rather than assumed.
VITE_OPENAI_API_KEY=

# Optional. Overrides OPENAI_REALTIME_MODEL / OPENAI_REALTIME_VOICE in
# src/voice/openaiRealtimeClient.ts. Defaults when blank: gpt-realtime / alloy
VITE_OPENAI_REALTIME_MODEL=
VITE_OPENAI_REALTIME_VOICE=
# Input transcription model. Pinning the language to en is not optional and is
# not configurable here: without it the transcriber auto-detects and the model
# answers in whatever language it thinks it heard.
VITE_OPENAI_TRANSCRIBE_MODEL=

# PostHog project (ingest) key, phc_… — publishable and write-only by design, so
# Vite inlining it into dist/ is fine and expected. NEVER put a phx_ personal API
# key here: that one is an account-scoped read credential and would be readable by
# every visitor. PostHog → Settings → Project → Project API Key.
# Leave blank and src/lib/analytics.ts is a no-op.
VITE_POSTHOG_KEY=
